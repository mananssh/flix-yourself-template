# CockroachDB Configuration
# Best for: Production deployments, distributed systems, global scale
# Pros: PostgreSQL-compatible, built-in replication, serverless tier available
# Cons: Slight learning curve, requires account setup

DATABASE_PROVIDER=cockroachdb
DATABASE_URL=postgresql://username:password@cluster-name.cockroachlabs.cloud:26257/flix_yourself?sslmode=verify-full

# CockroachDB Serverless (free tier):
# DATABASE_URL=postgresql://user:password@free-tier.gcp-us-central1.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full&options=--cluster%3Dcluster-name-1234

# CockroachDB Dedicated:
# DATABASE_URL=postgresql://user:password@cluster-name-1234.aws-us-east-1.cockroachlabs.cloud:26257/flix_yourself?sslmode=verify-full

# Note: CockroachDB URLs typically require SSL and cluster parameters
