# PostgreSQL Configuration
# Best for: Production deployments, self-hosted, traditional databases
# Pros: Mature, widely supported, excellent tooling, free hosting options
# Cons: Requires separate database server setup

DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://username:password@localhost:5432/flix_yourself?schema=public

# Examples for popular hosts:

# Local PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/flix_yourself

# Neon (serverless Postgres):
# DATABASE_URL=postgresql://user:password@ep-cool-name-123456.us-east-2.aws.neon.tech/flix_yourself?sslmode=require

# Supabase:
# DATABASE_URL=postgresql://postgres:password@db.projectref.supabase.co:5432/postgres

# Railway:
# DATABASE_URL=postgresql://postgres:password@containers-us-west-123.railway.app:5432/railway

# Render:
# DATABASE_URL=postgresql://user:password@dpg-abc123-a.oregon-postgres.render.com/database_name
