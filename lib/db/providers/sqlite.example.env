# SQLite Configuration
# Best for: Local development, testing, single-user deployments
# Pros: Zero setup, file-based, great for getting started
# Cons: Single connection, not suitable for production multi-user scenarios

DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./dev.db

# Optional: For production SQLite deployments with better concurrency
# DATABASE_URL=file:./production.db?connection_limit=1&pool_timeout=10
