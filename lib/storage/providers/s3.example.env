# Amazon S3 (or any S3-compatible service: MinIO, DigitalOcean Spaces, …)

STORAGE_PROVIDER=s3

STORAGE_S3_BUCKET=my-flix-videos
STORAGE_S3_REGION=us-east-1

AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Optional: custom endpoint for S3-compatible services.
# STORAGE_S3_ENDPOINT=https://nyc3.digitaloceanspaces.com

# Optional: path-style addressing, required by some S3-compatible services (e.g. MinIO).
# STORAGE_S3_FORCE_PATH_STYLE=true
