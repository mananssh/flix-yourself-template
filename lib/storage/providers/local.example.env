# Local Filesystem Storage (minimal, zero external dependencies)
# Objects are written under STORAGE_LOCAL_PATH on local disk.
# Best for development and single-node self-hosting.

STORAGE_PROVIDER=local

# Directory where objects are stored (relative to the project root or absolute).
STORAGE_LOCAL_PATH=./uploads

# App route prefix used to build URLs for stored objects.
# Your media-serving route should be mounted here.
STORAGE_LOCAL_BASE_URL=/api/media/file
