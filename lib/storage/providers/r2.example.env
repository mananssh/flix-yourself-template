# Cloudflare R2 (S3-compatible, zero egress fees — ideal for video streaming)

STORAGE_PROVIDER=r2

# Your Cloudflare account ID (Dashboard > R2 > account details).
STORAGE_R2_ACCOUNT_ID=your-account-id
STORAGE_R2_BUCKET=my-flix-videos

# R2 API token credentials (Dashboard > R2 > Manage API Tokens).
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
