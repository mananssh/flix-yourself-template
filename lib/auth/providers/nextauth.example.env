# Auth provider: nextauth (OAuth via NextAuth / Auth.js v5, self-hosted)
# Copy to .env in the project root: cp lib/auth/providers/nextauth.example.env .env

AUTH_PROVIDER=nextauth

# REQUIRED: secret used to sign/encrypt NextAuth JWTs.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Canonical app URL (used for OAuth callbacks):
NEXTAUTH_URL=http://localhost:3000

# Configure at least ONE provider (both id AND secret required per provider).
# Google: https://console.cloud.google.com/apis/credentials
#   Redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub: https://github.com/settings/developers
#   Callback URL: <NEXTAUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
