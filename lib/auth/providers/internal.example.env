# Auth provider: internal (email/password, bcrypt + signed cookie sessions)
# Copy to .env in the project root: cp lib/auth/providers/internal.example.env .env

AUTH_PROVIDER=internal

# REQUIRED: secret used to HMAC-sign session cookies (min 16 chars).
# Generate one with: openssl rand -base64 32
AUTH_SESSION_SECRET=replace-with-a-long-random-string

# Optional:
AUTH_ALLOW_SIGNUP=true                # allow self-registration (default: true)
AUTH_REQUIRE_EMAIL_VERIFICATION=false # reserved, not yet enforced (default: false)
AUTH_SESSION_MAX_AGE_DAYS=7           # session lifetime in days (default: 7)
