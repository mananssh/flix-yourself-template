# Database Configuration
# Copy this file to .env and update with your values
# See lib/db/providers/ for provider-specific examples

DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./dev.db

# For production, use PostgreSQL or CockroachDB:
# DATABASE_PROVIDER=postgresql
# DATABASE_URL=postgresql://user:password@host:5432/database

# Or CockroachDB:
# DATABASE_PROVIDER=cockroachdb
# DATABASE_URL=postgresql://user:password@host:26257/database?sslmode=verify-full


# Storage Configuration
# Where media (videos, images, subtitles) is stored.
# See lib/storage/providers/ for provider-specific examples.

STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_LOCAL_BASE_URL=/api/media/file

# For production, use a cloud provider, e.g. Cloudflare R2 (zero egress):
# STORAGE_PROVIDER=r2
# STORAGE_R2_ACCOUNT_ID=your-account-id
# STORAGE_R2_BUCKET=my-flix-videos
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Amazon S3 (or S3-compatible):
# STORAGE_PROVIDER=s3
# STORAGE_S3_BUCKET=my-flix-videos
# STORAGE_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# STORAGE_S3_ENDPOINT=            # optional, for S3-compatible services
# STORAGE_S3_FORCE_PATH_STYLE=    # optional, true for MinIO etc.

# Google Cloud Storage:
# STORAGE_PROVIDER=gcs
# STORAGE_GCS_BUCKET=my-flix-videos
# STORAGE_GCS_PROJECT_ID=my-gcp-project
# STORAGE_GCS_KEY_FILE=./gcp-service-account.json

# Azure Blob Storage:
# STORAGE_PROVIDER=azure
# STORAGE_AZURE_ACCOUNT_NAME=myaccount
# STORAGE_AZURE_ACCOUNT_KEY=your-storage-account-key
# STORAGE_AZURE_CONTAINER=videos
